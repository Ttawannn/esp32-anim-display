{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "mock-board",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/scripts/mock-board.mjs"
      ],
      "port": 8787
    },
    {
      "name": "web-editor-with-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev:mock",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
